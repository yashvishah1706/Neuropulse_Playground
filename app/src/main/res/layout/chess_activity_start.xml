<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".chessMainActivity"
    android:background="@drawable/chessintro">
    <!-- <ImageView-->
    <!-- android:id="@+id/start_screen"-->
    <!-- android:layout_width="512dp"-->
    <!-- android:layout_height="920dp"-->
    <!-- android:contentDescription="@string/start_screen"-->
    <!-- app:layout_constraintBottom_toBottomOf="parent"-->
    <!-- app:layout_constraintEnd_toEndOf="parent"-->
    <!-- app:layout_constraintStart_toStartOf="parent"-->
    <!-- app:layout_constraintTop_toTopOf="parent"-->
    <!-- app:layout_constraintVertical_bias="1.0"-->
    <!-- app:srcCompat="@drawable/chessintro" />-->
    <Button
        android:id="@+id/choose_a_name"
        android:layout_width="303dp"
        android:layout_height="61dp"
        android:background="@color/transparent"
        android:contentDescription="@string/choose_a_name"
        android:onClick="buttonClickName"
        android:text="@string/choose_a_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.481"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.533"
        tools:ignore="SpeakableTextPresentCheck" />
    <Button
        android:id="@+id/new_game"
        android:layout_width="303dp"
        android:layout_height="64dp"
        android:background="@color/transparent"
        android:contentDescription="@string/new_game"
        android:onClick="buttonClickGame"
        android:text="@string/new_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.481"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/choose_a_name"
        app:layout_constraintVertical_bias="0.218"
        tools:ignore="SpeakableTextPresentCheck" />
    <Button
        android:id="@+id/about_me"
        android:layout_width="299dp"
        android:layout_height="63dp"
        android:background="@color/transparent"
        android:contentDescription="@string/about"
        android:onClick="buttonClickAbout"
        android:text="@string/about"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/new_game"
        app:layout_constraintVertical_bias="0.313"
        tools:ignore="SpeakableTextPresentCheck" />

    <Button
        android:id="@+id/linkStartScreen"
        android:layout_width="292dp"
        android:layout_height="33dp"
        android:layout_marginBottom="280dp"
        android:background="@color/transparent"
        android:contentDescription="@string/how_to_play"
        android:onClick="buttonClickGameRules"
        app:layout_constraintBottom_toTopOf="@+id/choose_a_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.689"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/home"
        android:layout_width="99dp"
        android:layout_height="75dp"
        android:background="@color/transparent"
        android:onClick="home"
        android:text=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.975"
        tools:ignore="MissingConstraints" />
</androidx.constraintlayout.widget.ConstraintLayout>