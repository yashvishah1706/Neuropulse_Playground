<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/autism_back">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Results:"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.233"></TextView>
    <Button
        android:id="@+id/home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#aec0d1"
        android:onClick="home"
        android:text="Home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.434" />

    <Button
        android:id="@+id/aspergersyndrome"
        android:layout_width="182dp"
        android:layout_height="57dp"
        android:background="@drawable/button_rounded_corner"
        android:backgroundTint="#ABD2E5"
        android:onClick="aspergersyndrome"
        android:text="asperger syndrome"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.532"
        android:visibility="gone"/>

    <Button
        android:id="@+id/kannersyndrome"
        android:layout_width="170dp"
        android:layout_height="55dp"
        android:background="@drawable/button_rounded_corner"
        android:backgroundTint="#ABD2E5"
        android:onClick="kannersyndrome"
        android:text="kanner's syndrome"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.625"
        android:visibility="gone"/>

    <Button
        android:id="@+id/rettsyndrome"
        android:layout_width="145dp"
        android:layout_height="51dp"
        android:background="@drawable/button_rounded_corner"
        android:backgroundTint="#ABD2E5"
        android:onClick="rettsyndrome"
        android:text="rett syndrome"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.723"
        android:visibility="gone"/>

    <Button
        android:id="@+id/pervasivedevelopmentaldisorder"
        android:layout_width="282dp"
        android:layout_height="51dp"
        android:background="@drawable/button_rounded_corner"
        android:backgroundTint="#ABD2E5"
        android:onClick="pervasivedevelopmentaldisorder"
        android:text="pervasive developmental disorder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.82"
        android:visibility="gone"/>

    <Button
        android:id="@+id/childhooddisintegrativedisorder"
        android:layout_width="279dp"
        android:layout_height="57dp"
        android:background="@drawable/button_rounded_corner"
        android:backgroundTint="#ABD2E5"
        android:onClick="childhooddisintegrativedisorder"
        android:text="childhood disintegrative disorder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.922"
        android:visibility="gone"/>
</androidx.constraintlayout.widget.ConstraintLayout>
