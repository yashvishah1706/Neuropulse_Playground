<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chessname">

    <EditText
        android:id="@+id/player_1_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#594B4B"
        android:ems="14"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="@string/player_1"
        android:importantForAutofill="no"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:selectAllOnFocus="false"
        android:textColor="#030A0D"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.471" />
    <EditText
        android:id="@+id/player_2_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:backgroundTint="#594B4B"
        android:ems="14"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="@string/player_2"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:selectAllOnFocus="false"
        android:textColor="#030A0D"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_1_name"
        app:layout_constraintVertical_bias="0.324" />
    <Button
        android:id="@+id/done_name"
        android:layout_width="306dp"
        android:layout_height="91dp"
        android:background="@color/transparent"
        android:contentDescription="@string/done"
        android:longClickable="true"
        android:onClick="done"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_2_name"
        app:layout_constraintVertical_bias="0.612" />
    <Button
        android:id="@+id/linkNameScreen"
        android:layout_width="389dp"
        android:layout_height="56dp"
        android:layout_marginBottom="272dp"
        android:background="@color/transparent"
        android:contentDescription="@string/nickname_generator"
        android:onClick="buttonClickNameGenerator"
        app:layout_constraintBottom_toTopOf="@+id/player_1_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.363"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.012" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="31dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/linkNameScreen"
        app:layout_constraintVertical_bias="0.801"
        app:srcCompat="@drawable/home"
        android:onClick="home"/>
</androidx.constraintlayout.widget.ConstraintLayout>