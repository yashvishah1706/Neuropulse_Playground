<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/community_forum"
    >
    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:textSize="24sp"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/editTextQuery"
        android:layout_width="369dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edittext_rounded_corner"
        android:hint="Ask a question or post something"
        android:padding="12dp" />
    <Button
        android:id="@+id/buttonPost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_rounded_corner"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="Post"
        android:textColor="#FFFFFF" />
    <TextView
        android:id="@+id/textViewReply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reply will appear here"
        android:textSize="18sp"
        android:background="@drawable/edittext_rounded_corner"
        android:padding="16dp"
        android:visibility="gone"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="400dp">
        <LinearLayout
            android:id="@+id/postLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
    <LinearLayout
        android:id="@+id/likeDislikeLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        >

        <ImageButton
            android:id="@+id/buttonlike"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="1dp"
            android:background="@drawable/like1"
            android:onClick="like"
            android:visibility="gone">
        </ImageButton>
        <ImageButton
            android:id="@+id/buttonlike1"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="1dp"
            android:background="@drawable/like2"
            android:onClick="notlike"
            android:visibility="gone"
            >
        </ImageButton>
        <ImageButton
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:background="@drawable/dislike1"
            android:id="@+id/buttondislike"
            android:onClick="dislike"
            android:visibility="gone">
        </ImageButton>
        <ImageButton
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:background="@drawable/dislike2"
            android:id="@+id/buttondislike1"
            android:onClick="notdislike"
            android:visibility="gone">
        </ImageButton>
    </LinearLayout>

</LinearLayout>